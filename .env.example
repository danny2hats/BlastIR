# BlastIR configuration.
# Copy this to /etc/blastir.env (or pass via systemd EnvironmentFile=) and edit.

# Home Assistant / Mosquitto MQTT broker
BLASTIR_MQTT_BROKER=192.168.1.10
BLASTIR_MQTT_PORT=1883
BLASTIR_MQTT_USER=blastir
BLASTIR_MQTT_PASS=change-me

# Identifier used in MQTT discovery topics: homeassistant/button/<DEVICE_ID>_<slug>/config
BLASTIR_DEVICE_ID=blastir

# Web UI bind address
BLASTIR_HTTP_HOST=0.0.0.0
BLASTIR_HTTP_PORT=5000

# LIRC device paths (usually correct as-is on Pi with gpio-ir + gpio-ir-tx overlays)
BLASTIR_LIRC_TX=/dev/lirc0
BLASTIR_LIRC_RX=/dev/lirc1

# Where learned codes are stored (defaults to codes.json next to app.py)
# BLASTIR_CODES_FILE=/home/pi/blastir/codes.json
